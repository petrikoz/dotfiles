#!/bin/bash
set -euo pipefail

: "${PROJECT_NAME:?PROJECT_NAME is not set}"

# ****************************************************************
# DEFAULTS

dbname="$PROJECT_NAME"
sql=false
user="$dbname"
filepath=""

# ****************************************************************
# OPTIONS

while getopts ":d:f:su:" opt; do
    case $opt in
        d) dbname="$OPTARG"   ;;
        f) filepath="$OPTARG" ;;
        s) sql=true           ;;
        u) user="$OPTARG"     ;;
        ?)
            echo "Invalid option: -$OPTARG" >&2
            exit 1
            ;;
    esac
done

# если никаких опций не было, то читаем как файл
if [ "$OPTIND" -eq 1 ]; then
    filepath="${1:-}"
fi

if [ -z "$filepath" ]; then
    echo "File path is required" >&2
    exit 1
fi

# ****************************************************************
# EXECUTION

# если тип файла SQL (plain text), то загружаем через psql
if $sql; then
    psql -U "$user" -d "$dbname" -f "$filepath" --echo-errors
else
    pg_restore -U "$user" -d "$dbname" -Ov "$filepath"
fi
