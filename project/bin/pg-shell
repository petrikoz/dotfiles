#!/bin/bash
set -euo pipefail

: "${PROJECT_NAME:?PROJECT_NAME is not set}"

# ****************************************************************
# DEFAULTS

dbname="$PROJECT_NAME"
user="$dbname"

args=()

# ****************************************************************
# OPTIONS

while getopts ":d:u:" opt; do
    case $opt in
        d) dbname="$OPTARG" ;;
        u) user="$OPTARG"   ;;
        ?)
            echo "Invalid option: -$OPTARG" >&2
            exit 1
            ;;
    esac
done

shift $((OPTIND - 1))
args=("$@")

# ****************************************************************
# EXECUTION

psql -U "$user" -d "$dbname" "${args[@]}"
