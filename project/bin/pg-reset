#!/bin/bash
set -euo pipefail

: "${PROJECT:?PROJECT is not set}"
: "${PROJECT_NAME:?PROJECT_NAME is not set}"

# ****************************************************************
# DEFAULTS

dbname="$PROJECT_NAME"
owner="$dbname"
password="$PROJECT-password"
restore=""

# ****************************************************************
# HELPERS

pg_quote_ident() {
    local value="$1"
    value=${value//\"/\"\"}
    printf '"%s"' "$value"
}

pg_quote_literal() {
    local value="$1"
    value=${value//\'/\'\'}
    printf "'%s'" "$value"
}

# ****************************************************************
# OPTIONS

while getopts ":d:o:p:r:" opt; do
    case $opt in
        d) dbname="$OPTARG"   ;;
        o) owner="$OPTARG"    ;;
        p) password="$OPTARG" ;;
        r) restore="$OPTARG"  ;;
        ?)
            echo "Invalid option: -$OPTARG" >&2
            exit 1
            ;;
    esac
done

# ****************************************************************
# EXECUTION

# ********************************
# reset

dbname_sql=$(pg_quote_ident "$dbname")
owner_literal=$(pg_quote_literal "$owner")
owner_sql=$(pg_quote_ident "$owner")
password_sql=$(pg_quote_literal "$password")

queries=(
    "DROP DATABASE IF EXISTS ${dbname_sql};"
    "DO \$\$ BEGIN
        IF EXISTS (SELECT FROM pg_roles WHERE rolname = ${owner_literal}) THEN
            ALTER ROLE ${owner_sql} WITH LOGIN PASSWORD ${password_sql};
        ELSE
            CREATE ROLE ${owner_sql} WITH LOGIN PASSWORD ${password_sql};
        END IF;
    END \$\$;"
    "CREATE DATABASE ${dbname_sql} WITH OWNER ${owner_sql};"
    "GRANT ALL ON DATABASE ${dbname_sql} TO ${owner_sql};"
)

for query in "${queries[@]}"; do
    psql -U postgres -c "$query"
done

# ********************************
# restore

if [ -n "$restore" ]; then
    pg-restore -f "$restore"
fi
