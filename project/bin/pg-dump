#!/bin/bash
set -euo pipefail

: "${PROJECT_NAME:?PROJECT_NAME is not set}"
: "${PROJECT_TMP:?PROJECT_TMP is not set}"

# ****************************************************************
# DEFAULTS

dbname="$PROJECT_NAME"
filepath="$PROJECT_TMP/sql/local"
format="c"
user="$dbname"

args=()

# ****************************************************************
# OPTIONS

while getopts ":d:F:f:u:" opt; do
    case $opt in
        F) format="$OPTARG"   ;;
        d) dbname="$OPTARG"   ;;
        f) filepath="$OPTARG" ;;
        u) user="$OPTARG"     ;;
        ?)
            echo "Invalid option: -$OPTARG" >&2
            exit 1
            ;;
    esac
done

shift $((OPTIND - 1))
args=("$@")

# ****************************************************************
# EXECUTION

pg_dump -U "$user" -d "$dbname" -F "$format" -f "$filepath" -bcOv "${args[@]}"
