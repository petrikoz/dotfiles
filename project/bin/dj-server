#!/bin/bash
set -euo pipefail

# ****************************************************************
# DEFAULTS

addr="localhost"
port="8000"

args=()

# ****************************************************************
# OPTIONS

while getopts ":a:p:" opt; do
    case $opt in
        a) addr="$OPTARG" ;;
        p) port="$OPTARG" ;;
        ?)
            echo "Invalid option: -$OPTARG" >&2
            exit 1
            ;;
    esac
done

shift $((OPTIND - 1))
args=("$@")

# ****************************************************************
# EXECUTION

dj-exec runserver "$addr:$port" "${args[@]}"
