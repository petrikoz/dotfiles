#!/bin/bash
set -euo pipefail

: "${PROJECT:?PROJECT is not set}"
: "${PROJECT_ROOT:?PROJECT_ROOT is not set}"
: "${PROJECT_SRC:?PROJECT_SRC is not set}"

session="$PROJECT-cursor"

cd "$PROJECT_SRC" \
    && tmux new-session -d -s "$session" \
    && tmux send-keys -t "$session" "source \"\$PROJECT_ROOT/cursor-cli.env\" && cursor --verbose \"\$PROJECT_ROOT\"" C-m \
    && tmux split-window -t "$session" \
    && tmux attach-session -t "$session"
